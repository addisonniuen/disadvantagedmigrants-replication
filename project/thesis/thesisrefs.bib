@article{wang_labour_2022,
	title = {The labour surplus and {COVID}‐19: the outlook for {Chinese} migrant low‐skilled workers},
	volume = {62},
	issn = {0810-5391},
	shorttitle = {The labour surplus and {COVID}‐19},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC8212115/},
	doi = {10.1111/acfi.12800},
	abstract = {This paper investigates the disruption to global supply chains caused by COVID‐19 and how such disruptions will affect the participation of Chinese businesses in those chains. The focus is on the post‐COVID‐19 outlook for migrant workers working in the hospitality and garment industries. It is argued that managers within global supply chains will use accounting processes to maintain profitability by cutting costs. Moreover, within corporate supply chains, wages will be driven down in an increasingly competitive labour market, especially for low‐skilled workers. The findings show that COVID‐19 will have an adverse effect on wages and employment and raise performance expectations.},
